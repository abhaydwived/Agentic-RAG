# Google Gemini API Key (recommended / free tier available)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (gemini-2.5-flash is fast, capable, and cost-effective)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (optional fallback if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Web Search - Tavily API (free tier: 1000 requests/month)
# Sign up at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# OpenWeatherMap API (free tier: 60 calls/min)
# Sign up at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# Knowledge base path
KNOWLEDGE_BASE_DIR=data/knowledge_base
